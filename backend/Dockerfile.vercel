FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gdal-bin \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

RUN mkdir -p /app/data/maps
COPY . /app/backend

# Bake the road graph into the server image so requests do not depend on Overpass.
RUN python -c "import osmnx as ox; graph = ox.graph_from_point((-42.8826, 147.3257), dist=7000, network_type='drive', simplify=True); ox.save_graphml(graph, filepath='/app/data/maps/hobart_drive.graphml')"

EXPOSE 80

CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
